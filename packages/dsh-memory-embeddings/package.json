{
  "name": "@vkozachek/dsh-memory-embeddings",
  "version": "0.1.0",
  "description": "Optional embeddings and hybrid search for @vkozachek/dsh-memory; the main package stays offline.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
