  "repository": {
    "type": "git",
    "url": "git+https://github.com/VictorKozachek/dsh-memory.git"
  },
  "homepage": "https://github.com/VictorKozachek/dsh-memory#readme",
  "bugs": {
    "url": "https://github.com/VictorKozachek/dsh-memory/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "embeddings",
    "hybrid-search",
    "sqlite",
    "rag"
